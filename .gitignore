# C build outputs: executables have no extension on macOS, so ignore
# everything, re-include folders, then re-include files with an extension.
*
!*/
!*.*
!Makefile

# Debug-symbol bundles and objects (the !*.* rule above lets them back in)
*.dSYM/
*.o

# Editor-local config
*.code-workspace

# Scratch file from a Colab mount test
colab_test.txt

# macOS folder metadata (kept last: !*.* would otherwise re-include it,
# and in .gitignore the last matching rule wins)
.DS_Store
